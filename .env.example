# ==============================================================================
# ELECTROCOTIZA - VARIABLES DE ENTORNO (EJEMPLO)
# Construlogica Emprendimientos S.A.
# ==============================================================================

# URL Pública de la Aplicación
NEXT_PUBLIC_APP_URL=https://electrocotiza.vercel.app
NEXT_PUBLIC_APP_NAME=ElectroCotiza
NEXT_PUBLIC_DEFAULT_CURRENCY=PYG

# Base de Datos Serverless en la Nube (Neon PostgreSQL - Recomendado / Gratuito)
# Pega aquí el connection string proporcionado por neon.tech
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Configuración de Supabase (Alternativa - La app opera Local-First por defecto)
# Configura estas variables si deseas sincronizar en la nube con Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-privada

# Google Gemini API (Para extracción multimodal autónoma de facturas en servidor)
GEMINI_API_KEY=tu-api-key-de-google-gemini
